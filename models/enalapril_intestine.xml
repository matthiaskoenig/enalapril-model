    <listOfRules>
      <assignmentRule name="transit of enalapril (absorption and fecal excretion)" variable="absorption">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> ENAABS_k </ci>
            <ci> Vgu </ci>
            <ci> ena_lumen </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="f_dissolution">
        <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
          <apply>
            <plus/>
            <cn sbml:units="dimensionless" type="integer"> 1 </cn>
            <apply>
              <times/>
              <ci> fed </ci>
              <apply>
                <minus/>
                <ci> FED_f_dissolution </ci>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
              </apply>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <rateRule variable="PODOSE_ena">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci> dissolution_ena </ci>
            </apply>
            <ci> Mr_ena </ci>
          </apply>
        </math>
      </rateRule>
    </listOfRules>
    <listOfReactions>
      <reaction sboTerm="SBO:0000655" id="ENAABS" name="absorption enalapril" reversible="false" compartment="Vgu">
        <listOfReactants>
          <speciesReference species="ena_lumen" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="ena_ext" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> F_ena_abs </ci>
              <ci> absorption </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction sboTerm="SBO:0000655" id="ENAEXC" name="excretion enalapril (feces)" reversible="false" compartment="Vlumen">
        <listOfReactants>
          <speciesReference species="ena_lumen" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="ena_feces" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <times/>
              <apply>
                <minus/>
                <cn sbml:units="dimensionless" type="integer"> 1 </cn>
                <ci> F_ena_abs </ci>
              </apply>
              <ci> absorption </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="dissolution_ena" name="dissolution enalapril" reversible="false" compartment="Vgu">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">
            <p>Swallowing, dissolution of tablet, and transport into intestine.
Overall process describing the rates of this processes.</p>
          </body>
        </notes>
        <listOfReactants>
          <speciesReference species="ena_stomach" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="ena_lumen" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <divide/>
              <apply>
                <times/>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <ci> f_dissolution </ci>
                    <ci> Ka_dis_ena </ci>
                  </apply>
                  <cn sbml:units="min_per_hr" type="integer"> 60 </cn>
                </apply>
                <ci> PODOSE_ena </ci>
              </apply>
              <ci> Mr_ena </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
